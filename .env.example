# ======================================
# HMIS API - Configuration Environment
# Hankes Music Intelligence System v2.0
# ======================================

# --------------------------
# SERVER CONFIGURATION
# --------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# --------------------------
# JWT SECURITY
# --------------------------
# Générer avec: openssl rand -hex 64
JWT_SECRET=votre-secret-jwt-tres-long-et-securise-changez-cette-valeur-en-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------
# SUPABASE DATABASE
# --------------------------
# Récupérez ces URLs depuis votre dashboard Supabase > Settings > Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --------------------------
# REDIS (OTP & Cache)
# --------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------
# TWILIO SMS (OTP)
# --------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --------------------------
# ACRCLOUD (Reconnaissance Musicale - Primaire)
# --------------------------
ACRCLOUD_API_KEY=
ACRCLOUD_API_SECRET=
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com

# --------------------------
# AUDD (Reconnaissance Musicale - Fallback)
# --------------------------
AUDD_API_TOKEN=

# --------------------------
# AWS S3 (Storage Audio)
# --------------------------
AWS_S3_BUCKET=hmis-uploads
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --------------------------
# AWS SES (Emails)
# --------------------------
SES_FROM_EMAIL=noreply@hmis-project.ci

# --------------------------
# RATE LIMITING
# --------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------
# LOGGING
# --------------------------
LOG_LEVEL=info
