{
  "info": {
    "name": "HMIS API v2.0",
    "description": "Hankes Music Intelligence System - API de tracking musical",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {"key": "token", "value": "{{accessToken}}", "type": "string"}
    ]
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:3000", "type": "string"}
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 201) { const json = pm.response.json(); pm.environment.set('userId', json.userId); console.log('✅ User registered, ID:', json.userId); }"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"test{{randomInt}}@hmis.ci\",\n  \"password\": \"Password123!\",\n  \"nom\": \"Test User\",\n  \"telephone\": \"+2250707070707\",\n  \"role\": \"etablissement\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "register"]}
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {"mode": "raw", "raw": "{\n  \"phone\": \"+2250707070707\",\n  \"otp\": \"123456\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/v1/auth/otp/verifier", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "otp", "verifier"]}
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 200) { const json = pm.response.json(); pm.environment.set('accessToken', json.accessToken); pm.environment.set('refreshToken', json.refreshToken); pm.environment.set('userId', json.user.id); console.log('✅ Logged in, token expires in:', json.expiresIn, 's'); }"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"test@hmis.ci\",\n  \"password\": \"Password123!\",\n  \"deviceId\": \"device-{{randomInt}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"]}
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 200) { const json = pm.response.json(); pm.environment.set('accessToken', json.accessToken); pm.environment.set('refreshToken', json.refreshToken); }"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {"mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "refresh"]}
          }
        },
        {
          "name": "Get Current User",
          "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "me"]}}
        },
        {
          "name": "Logout",
          "request": {"method": "POST", "header": [], "url": {"raw": "{{baseUrl}}/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "logout"]}}
        }
      ]
    },
    {
      "name": "🏢 Établissements",
      "item": [
        {
          "name": "List Établissements",
          "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/etablissements?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["v1", "etablissements"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "10"}]}}
        },
        {
          "name": "Create Établissement",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 201) { const json = pm.response.json(); pm.environment.set('etablissementId', json.data.id); }"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {"mode": "raw", "raw": "{\n  \"nom\": \"Maquis Test {{randomInt}}\",\n  \"type\": \"maquis\",\n  \"adresse\": \"Rue des Jardins, Cocody\",\n  \"ville\": \"Abidjan\",\n  \"region\": \"Lagunes\",\n  \"telephone\": \"+2250707070707\",\n  \"email\": \"contact@maquis-test.ci\",\n  \"capacite\": 100,\n  \"licence\": \"LIC-2025-001\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/v1/etablissements", "host": ["{{baseUrl}}"], "path": ["v1", "etablissements"]}
          }
        },
        {
          "name": "Get Établissement by ID",
          "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/etablissements/{{etablissementId}}", "host": ["{{baseUrl}}"], "path": ["v1", "etablissements", "{{etablissementId}}"]}}
        },
        {
          "name": "Update Établissement",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {"mode": "raw", "raw": "{\n  \"capacite\": 150,\n  \"licence\": \"LIC-2025-002\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/v1/etablissements/{{etablissementId}}", "host": ["{{baseUrl}}"], "path": ["v1", "etablissements", "{{etablissementId}}"]}
          }
        },
        {
          "name": "Validate Établissement (Admin)",
          "request": {"method": "POST", "header": [], "url": {"raw": "{{baseUrl}}/v1/etablissements/{{etablissementId}}/valider", "host": ["{{baseUrl}}"], "path": ["v1", "etablissements", "{{etablissementId}}", "valider"]}}
        },
        {
          "name": "Get Établissement Stats",
          "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/etablissements/{{etablissementId}}/stats?startDate=2025-01-01T00:00:00Z&endDate=2025-12-31T23:59:59Z", "host": ["{{baseUrl}}"], "path": ["v1", "etablissements", "{{etablissementId}}", "stats"], "query": [{"key": "startDate", "value": "2025-01-01T00:00:00Z"}, {"key": "endDate", "value": "2025-12-31T23:59:59Z"}]}}
        }
      ]
    },
    {
      "name": "🎵 Diffusions",
      "item": [
        {"name": "List Diffusions", "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/diffusions?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["v1", "diffusions"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "20"}]}}},
        {"name": "Top Musiques", "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/diffusions/top/musiques?limit=10", "host": ["{{baseUrl}}"], "path": ["v1", "diffusions", "top", "musiques"], "query": [{"key": "limit", "value": "10"}]}}},
        {"name": "Top Artistes", "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/diffusions/top/artistes?limit=10", "host": ["{{baseUrl}}"], "path": ["v1", "diffusions", "top", "artistes"], "query": [{"key": "limit", "value": "10"}]}}}
      ]
    },
    {
      "name": "📊 Dashboard",
      "item": [
        {"name": "Get KPIs (Admin)", "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/dashboard/kpi", "host": ["{{baseUrl}}"], "path": ["v1", "dashboard", "kpi"]}},
        {"name": "Get Carte", "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/dashboard/carte", "host": ["{{baseUrl}}"], "path": ["v1", "dashboard", "carte"]}},
        {"name": "Get Évolution", "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/dashboard/evolution?period=30", "host": ["{{baseUrl}}"], "path": ["v1", "dashboard", "evolution"], "query": [{"key": "period", "value": "30"}]}}}
      ]
    },
    {
      "name": "📱 Devices",
      "item": [
        {
          "name": "Register Device",
          "request": {
            "method": "POST",
            "header": [],
            "body": {"mode": "raw", "raw": "{\n  \"deviceId\": \"device-{{randomInt}}\",\n  \"platform\": \"ios\",\n  \"appVersion\": \"1.0.0\",\n  \"osVersion\": \"17.0\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/v1/devices", "host": ["{{baseUrl}}"], "path": ["v1", "devices"]}
          }
        },
        {"name": "List My Devices", "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/devices", "host": ["{{baseUrl}}"], "path": ["v1", "devices"]}}
      ]
    },
    {
      "name": "🏥 Health Check",
      "item": [
        {"name": "Health Status", "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/health", "host": ["{{baseUrl}}"], "path": ["v1", "health"]}},
        {"name": "Database Status", "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/v1/health/db", "host": ["{{baseUrl}}"], "path": ["v1", "health", "db"]}}
      ]
    }
  ]
}
