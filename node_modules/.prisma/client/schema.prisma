generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Utilisateurs du système (admins, gérants d'établissements, partenaires)
model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String
  nom             String
  telephone       String
  role            UserRole       @default(etablissement)
  isVerified      Boolean        @default(false)
  isActive        Boolean        @default(true)
  etablissementId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  audioCaptures   AudioCapture[]
  devices         Device[]
  diffusions      Diffusion[]
  etablissement   Etablissement?
  notifications   Notification[]
  rapports        Rapport[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

/// Établissements (bars, maquis, boîtes de nuit, etc.)
model Etablissement {
  id            String            @id @default(uuid())
  nom           String
  type          EtablissementType
  adresse       String
  ville         String
  region        String
  latitude      Float?
  longitude     Float?
  telephone     String
  email         String?
  gerantId      String            @unique
  isActive      Boolean           @default(true)
  isVerified    Boolean           @default(false)
  capacite      Int?
  licence       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  audioCaptures AudioCapture[]
  devices       Device[]
  diffusions    Diffusion[]
  gerant        User              @relation(fields: [gerantId], references: [id], onDelete: Cascade)
  rapports      Rapport[]

  @@map("etablissements")
}

/// Captures audio envoyées par les appareils pour identification
model AudioCapture {
  id              String             @id @default(uuid())
  etablissementId String
  userId          String
  audioUrl        String
  duree           Int
  format          String
  taille          Int
  statut          AudioCaptureStatut @default(pending)
  deviceId        String
  capturedAt      DateTime
  syncedAt        DateTime?
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  device          Device             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  etablissement   Etablissement      @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recognition     MusicRecognition?

  @@map("audio_captures")
}

/// Résultats de la reconnaissance musicale (ACRCloud, AUDD, etc.)
model MusicRecognition {
  id         String       @id @default(uuid())
  captureId  String       @unique
  titre      String
  artiste    String
  album      String?
  isrc       String?      @unique
  label      String?
  genre      String?
  annee      Int?
  confidence Float
  source     String
  metadata   Json?
  createdAt  DateTime     @default(now())
  diffusions Diffusion[]
  capture    AudioCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@map("music_recognitions")
}

/// Diffusions de musique dans les établissements
model Diffusion {
  id              String           @id @default(uuid())
  etablissementId String
  musicId         String
  titre           String
  artiste         String
  playedAt        DateTime
  duree           Int
  source          DiffusionSource
  createdAt       DateTime         @default(now())
  userId          String?
  etablissement   Etablissement    @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  music           MusicRecognition @relation(fields: [musicId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id])

  @@map("diffusions")
}

/// Appareils mobiles enregistrés
model Device {
  id              String         @id @default(uuid())
  userId          String
  etablissementId String?
  deviceId        String         @unique
  platform        DevicePlatform
  appVersion      String
  osVersion       String
  pushToken       String?
  lastActiveAt    DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  audioCaptures   AudioCapture[]
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

/// Tokens OTP pour vérification SMS
model OTP {
  id        String     @id @default(uuid())
  phone     String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  isUsed    Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@map("otps")
}

/// Refresh tokens pour maintien de session
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/// Notifications push/in-app
model Notification {
  id          String           @id @default(uuid())
  userId      String
  titre       String
  message     String
  type        NotificationType @default(INFO)
  estLue      Boolean          @default(false)
  dateLecture DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Rapports générés (PDF, Excel, etc.)
model Rapport {
  id              String         @id @default(uuid())
  type            RapportType
  dateDebut       DateTime
  dateFin         DateTime
  format          RapportFormat  @default(pdf)
  statut          RapportStatut  @default(en_cours)
  fichierUrl      String?
  dateGeneration  DateTime       @default(now())
  generePar       String
  metadata        Json?
  createdAt       DateTime       @default(now())
  etablissementId String?
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id])
  user            User           @relation(fields: [generePar], references: [id], onDelete: Cascade)

  @@map("rapports")
}

enum UserRole {
  admin
  etablissement
  partenaire
}

enum EtablissementType {
  bar
  maquis
  cave
  boite_de_nuit
  restaurant
  hotel
}

enum AudioCaptureStatut {
  pending
  processing
  identified
  failed
}

enum DiffusionSource {
  capture
  manual
  playlist
}

enum DevicePlatform {
  ios
  android
}

enum OtpPurpose {
  REGISTER
  LOGIN
  PASSWORD_RESET
  TWO_FACTOR
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SUCCESS
}

enum RapportType {
  etablissement
  periode
  artiste
  global
}

enum RapportFormat {
  pdf
  excel
  csv
}

enum RapportStatut {
  en_cours
  termine
  failed
}
