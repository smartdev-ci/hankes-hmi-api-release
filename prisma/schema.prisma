generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// MODÈLES UTILISATEURS
// ============================================================

/// Utilisateurs du système (admins, gérants, recenseurs, artistes, partenaires)
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  nom             String
  telephone       String    @unique
  role            UserRole  @default(etablissement)
  isVerified      Boolean   @default(false)
  isActive        Boolean   @default(true)
  etablissementId String?   // Gardé pour compatibilité — UNIQUE supprimé
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations existantes
  audioCaptures  AudioCapture[]
  devices        Device[]
  diffusions     Diffusion[]
  notifications  Notification[]
  rapports       Rapport[]
  refreshTokens  RefreshToken[]

  // Gérant d'établissement (relation existante renommée pour clarté)
  etablissement  Etablissement? @relation("GerantEtablissement")

  // NOUVELLES relations
  recenseurProfile      RecenseurProfile?   @relation("UserRecenseurProfile")
  artisteProfile        ArtisteProfile?     @relation("UserArtisteProfile")
  etablissementsCrees   Etablissement[]     @relation("CreateurEtablissement")
  recenseursCrees       RecenseurProfile[]  @relation("AdminCreateurRecenseur")
  etablissementUsers    EtablissementUser[] @relation("UserEtablissements")
  assignementsEffectues EtablissementUser[] @relation("AssignePar")
  musiquesRevendiquees  ArtisteMusique[]

  @@map("users")
}

/// Profil étendu d'un agent recenseur (créé par un admin)
model RecenseurProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  numeroPiece      String
  typePiece        PieceIdentiteType
  dateNaissance    DateTime          @db.Date
  photoIdentiteUrl String
  creePar          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user  User @relation("UserRecenseurProfile",   fields: [userId],  references: [id], onDelete: Cascade)
  admin User @relation("AdminCreateurRecenseur", fields: [creePar], references: [id], onDelete: Restrict)

  @@map("recenseur_profiles")
}

/// Profil étendu d'un artiste (inscription publique)
model ArtisteProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  nomArtiste String
  bio        String?
  isrc       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation("UserArtisteProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@map("artiste_profiles")
}

// ============================================================
// MODÈLES ÉTABLISSEMENTS
// ============================================================

/// Établissements (bars, maquis, boîtes de nuit, etc.)
model Etablissement {
  id           String            @id @default(uuid())
  nom          String
  type         EtablissementType
  adresse      String
  ville        String
  region       String
  latitude     Float?
  longitude    Float?
  telephone    String
  email        String?
  gerantId     String            @unique
  isActive     Boolean           @default(true)
  isVerified   Boolean           @default(false)
  capacite     Int?
  licence      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // NOUVELLES colonnes — traçabilité de la création
  creePar      String?       // ID de l'admin ou recenseur ayant créé l'établissement
  roleCreateur CreatorRole?  // Précise si créé par admin ou recenseur

  // Relations existantes
  audioCaptures AudioCapture[]
  devices       Device[]
  diffusions    Diffusion[]
  rapports      Rapport[]
  gerant        User          @relation("GerantEtablissement",   fields: [gerantId], references: [id], onDelete: Cascade)

  // NOUVELLES relations
  createur User?               @relation("CreateurEtablissement", fields: [creePar], references: [id], onDelete: SetNull)
  membres  EtablissementUser[]

  @@index([creePar])
  @@map("etablissements")
}

/// Membres liés à un établissement (hors gérant)
model EtablissementUser {
  id              String   @id @default(uuid())
  etablissementId String
  userId          String
  role            String   @default("staff")
  assigneAt       DateTime @default(now())
  assignePar      String

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  user          User          @relation("UserEtablissements", fields: [userId],     references: [id], onDelete: Cascade)
  assigne       User          @relation("AssignePar",         fields: [assignePar], references: [id], onDelete: Restrict)

  @@unique([etablissementId, userId])
  @@map("etablissement_users")
}

// ============================================================
// MODÈLES AUDIO & RECONNAISSANCE
// ============================================================

/// Captures audio envoyées par les appareils pour identification
model AudioCapture {
  id              String             @id @default(uuid())
  etablissementId String
  userId          String
  audioUrl        String
  duree           Int
  format          String
  taille          Int
  statut          AudioCaptureStatut @default(pending)
  deviceId        String?
  capturedAt      DateTime
  syncedAt        DateTime?
  processedAt     DateTime?
  createdAt       DateTime           @default(now())

  device        Device?          @relation(fields: [deviceId],        references: [id], onDelete: SetNull)
  etablissement Etablissement    @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId],          references: [id], onDelete: Cascade)
  recognition   MusicRecognition?
  diffusions    Diffusion[]

  @@map("audio_captures")
}

/// Résultats de la reconnaissance musicale (ACRCloud, AudD)
model MusicRecognition {
  id        String   @id @default(uuid())
  captureId String   @unique
  trackId   String?
  titre     String
  artiste   String
  album     String?
  isrc      String?  // UNIQUE supprimé — même ISRC peut apparaître sur plusieurs captures
  label     String?
  genre     String?
  annee     Int?
  confidence Float
  source    String
  metadata  Json?
  createdAt DateTime @default(now())

  capture         AudioCapture     @relation(fields: [captureId], references: [id], onDelete: Cascade)
  track           Track?           @relation(fields: [trackId], references: [id], onDelete: SetNull)
  fingerprints    Fingerprint[]
  diffusions      Diffusion[]
  artisteMusiques ArtisteMusique[] // NOUVEAU — revendications artistes

  @@index([isrc]) // Index simple (non unique) pour le matching
  @@index([trackId])
  @@map("music_recognitions")
}

/// Bibliothèque musicale propriétaire construite à partir des reconnaissances
model Track {
  id            String   @id @default(uuid())
  titre         String   @db.VarChar(255)
  artiste       String   @db.VarChar(255)
  album         String?  @db.VarChar(255)
  isrc          String?  @db.VarChar(50)
  genre         String?  @db.VarChar(255)
  annee         Int?
  normalizedKey String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases      TrackAlias[]
  fingerprints Fingerprint[]
  recognitions MusicRecognition[]

  @@index([isrc])
  @@index([artiste])
  @@map("tracks")
}

/// Variantes orthographiques d'un titre ou d'un artiste
model TrackAlias {
  id              String   @id @default(uuid())
  trackId         String
  alias           String   @db.VarChar(255)
  normalizedAlias String
  createdAt       DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("track_aliases")
}

/// Empreintes audio associées aux reconnaissances locales
model Fingerprint {
  id              String   @id @default(uuid())
  fingerprint     String   @db.Text
  fingerprintHash String
  algorithm       String   @default("sha256_fallback")
  recognitionId   String
  trackId         String?
  createdAt       DateTime @default(now())

  recognition MusicRecognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  track       Track?           @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([fingerprintHash])
  @@index([trackId])
  @@map("fingerprints")
}

/// Revendication d'une musique par un artiste (matching via nom + ISRC)
model ArtisteMusique {
  id                 String   @id @default(uuid())
  artisteUserId      String
  musicRecognitionId String?
  isrc               String?  // Pour matcher même sans musicRecognitionId
  nomArtiste         String   // Pour matcher via le nom en texte libre
  verifie            Boolean  @default(false)
  revendiqueAt       DateTime @default(now())

  artiste          User              @relation(fields: [artisteUserId],      references: [id], onDelete: Cascade)
  musicRecognition MusicRecognition? @relation(fields: [musicRecognitionId], references: [id], onDelete: SetNull)

  @@unique([artisteUserId, musicRecognitionId])
  @@index([isrc])
  @@index([nomArtiste])
  @@map("artiste_musiques")
}

// ============================================================
// MODÈLES DIFFUSION
// ============================================================

/// Diffusions de musique dans les établissements
model Diffusion {
  id              String          @id @default(uuid())
  etablissementId String
  musicId         String
  titre           String
  artiste         String
  playedAt        DateTime
  duree           Int
  source          DiffusionSource
  createdAt       DateTime        @default(now())
  userId          String?
  captureId       String?         // NOUVEAU — lien vers la capture source

  etablissement Etablissement    @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  music         MusicRecognition @relation(fields: [musicId],         references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId],          references: [id])
  capture       AudioCapture?    @relation(fields: [captureId],       references: [id], onDelete: SetNull)

  // Index de performance pour le récap artiste
  @@index([musicId, playedAt(sort: Desc)])
  @@index([etablissementId, playedAt(sort: Desc)])
  @@map("diffusions")
}

// ============================================================
// MODÈLES DEVICES, AUTH & NOTIFICATIONS
// ============================================================

/// Appareils mobiles enregistrés
model Device {
  id              String         @id @default(uuid())
  userId          String
  etablissementId String?
  deviceId        String         @unique
  platform        DevicePlatform
  appVersion      String
  osVersion       String
  pushToken       String?
  lastActiveAt    DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  audioCaptures AudioCapture[]
  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  user          User           @relation(fields: [userId],          references: [id], onDelete: Cascade)

  @@map("devices")
}

/// Tokens OTP pour vérification SMS
model OTP {
  id        String     @id @default(uuid())
  phone     String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  isUsed    Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@map("otps")
}

/// Refresh tokens pour maintien de session
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/// Notifications push/in-app
model Notification {
  id          String           @id @default(uuid())
  userId      String
  titre       String
  message     String
  type        NotificationType @default(INFO)
  estLue      Boolean          @default(false)
  dateLecture DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================================
// MODÈLES RAPPORTS
// ============================================================

/// Rapports générés (PDF, Excel, etc.)
model Rapport {
  id              String        @id @default(uuid())
  type            RapportType
  dateDebut       DateTime
  dateFin         DateTime
  format          RapportFormat @default(pdf)
  statut          RapportStatut @default(en_cours)
  fichierUrl      String?
  dateGeneration  DateTime      @default(now())
  generePar       String
  metadata        Json?
  createdAt       DateTime      @default(now())
  etablissementId String?

  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  user          User           @relation(fields: [generePar],       references: [id], onDelete: Cascade)

  @@map("rapports")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  admin
  etablissement
  partenaire
  recenseur  // NOUVEAU — agent recenseur créé par un admin
  artiste    // NOUVEAU — artiste inscrit publiquement
}

enum PieceIdentiteType {  // NOUVEAU
  cni
  passeport
  titre_sejour
  carte_consulaire
}

enum CreatorRole {  // NOUVEAU — qui a créé l'établissement
  admin
  recenseur
}

enum EtablissementType {
  bar
  maquis
  cave
  boite_de_nuit
  restaurant
  hotel
}

enum AudioCaptureStatut {
  pending
  processing
  identified
  failed
}

enum DiffusionSource {
  capture
  manual
  playlist
}

enum DevicePlatform {
  ios
  android
}

enum OtpPurpose {
  REGISTER
  LOGIN
  PASSWORD_RESET
  TWO_FACTOR
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SUCCESS
}

enum RapportType {
  etablissement
  periode
  artiste
  global
}

enum RapportFormat {
  pdf
  excel
  csv
}

enum RapportStatut {
  en_cours
  termine
  failed
}
